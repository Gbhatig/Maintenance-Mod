datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Site {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  address     String?
  city        String?
  state       String?
  country     String   @default("IN")
  gstNo       String?  @map("gst_no")
  timezone    String   @default("Asia/Kolkata")
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  warehouses  Warehouse[]
  shifts      Shift[]
  machines    Machine[]
  employees   EmployeeSite[]

  @@map("sites")
}

model Warehouse {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  name      String
  type      String   @default("FABRICATION") // FABRICATION | GALVANIZING | FG_YARD | RAW_MATERIAL | OTHER
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  machines  Machine[]
  employees EmployeeWarehouse[]

  @@map("warehouses")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  isDeleted Boolean  @default(false) @map("is_deleted")

  roles     Role[]
  employees Employee[]

  @@map("departments")
}

model Role {
  id            String      @id @default(uuid())
  departmentId  String?     @map("department_id")
  name          String
  permissionSet String      @default("{}") @map("permission_set")
  isDeleted     Boolean     @default(false) @map("is_deleted")

  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees     Employee[]

  @@unique([departmentId, name])
  @@map("roles")
}

model Employee {
  id           String   @id @default(uuid())
  empCode      String   @unique @map("emp_code")
  name         String
  mobile       String?
  email        String?
  departmentId String   @map("department_id")
  roleId       String   @map("role_id")
  landingPage  String   @default("DEFAULT") @map("landing_page")
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedBy    String?  @map("updated_by")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  department   Department @relation(fields: [departmentId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])
  sites        EmployeeSite[]
  warehouses   EmployeeWarehouse[]
  roster       EmployeeShiftRoster[]
  user         User?
  leaves       EmployeeLeave[]

  @@map("employees")
}

model EmployeeLeave {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  leaveType   String   @default("CASUAL") @map("leave_type") // CASUAL | SICK | EARNED | MATERNITY | PATERNITY | UNPAID
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  totalDays   Int      @default(1) @map("total_days")
  reason      String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  approvedBy  String?  @map("approved_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_leaves")
}

model EmployeeSite {
  employeeId String   @map("employee_id")
  siteId     String   @map("site_id")

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([employeeId, siteId])
  @@map("employee_sites")
}

model EmployeeWarehouse {
  employeeId  String    @map("employee_id")
  warehouseId String    @map("warehouse_id")

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([employeeId, warehouseId])
  @@map("employee_warehouses")
}

model Shift {
  id           String   @id @default(uuid())
  siteId       String   @map("site_id")
  name         String
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  isOvernight  Boolean  @default(false) @map("is_overnight")
  breakMinutes Int      @default(0) @map("break_minutes")
  grossMinutes Int      @map("gross_minutes")
  netMinutes   Int      @map("net_minutes")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workingDays  ShiftWorkingDay[]
  roster       EmployeeShiftRoster[]
  machines     MachineShiftAssignment[]

  @@unique([siteId, name])
  @@map("shifts")
}

model ShiftWorkingDay {
  shiftId   String @map("shift_id")
  dayOfWeek Int    @map("day_of_week")

  shift     Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@id([shiftId, dayOfWeek])
  @@map("shift_working_days")
}

model EmployeeShiftRoster {
  id            String    @id @default(uuid())
  employeeId    String    @map("employee_id")
  shiftId       String    @map("shift_id")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@map("employee_shift_roster")
}

model Machine {
  id              String   @id @default(uuid())
  siteId          String   @map("site_id")
  warehouseId     String?  @map("warehouse_id")
  parentMachineId String?  @map("parent_machine_id")
  name            String
  level           Int      @default(0)
  path            String   @default("")
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  site            Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  parentMachine   Machine?  @relation("MachineTree", fields: [parentMachineId], references: [id], onDelete: Cascade)
  childMachines   Machine[] @relation("MachineTree")

  productionParams MachineProductionParam[]
  parameters       MachineParameter[]
  shifts           MachineShiftAssignment[]

  @@unique([parentMachineId, name])
  @@map("machines")
}

model MachineProductionParam {
  id          String  @id @default(uuid())
  machineId   String  @map("machine_id")
  metricName  String  @map("metric_name")
  unit        String
  isActive    Boolean @default(true) @map("is_active")

  machine     Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@map("machine_production_params")
}

model MachineParameter {
  id            String   @id @default(uuid())
  machineId     String   @map("machine_id")
  parameterName String   @map("parameter_name")
  minValue      Float?   @map("min_value")
  maxValue      Float?   @map("max_value")
  unit          String?

  machine       Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@map("machine_parameters")
}

model MachineShiftAssignment {
  machineId String  @map("machine_id")
  shiftId   String  @map("shift_id")

  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  shift     Shift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@id([machineId, shiftId])
  @@map("machine_shift_assignment")
}

model User {
  id           String    @id @default(uuid())
  employeeId   String?   @unique @map("employee_id")
  username     String    @unique
  passwordHash String?   @map("password_hash")
  lastLoginAt  DateTime? @map("last_login_at")
  isLocked     Boolean   @default(false) @map("is_locked")
  createdAt    DateTime  @default(now()) @map("created_at")

  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityName String   @map("entity_name")
  entityId   String   @map("entity_id")
  action     String
  actorId    String   @map("actor_id")
  diff       String?  @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor      User     @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}
